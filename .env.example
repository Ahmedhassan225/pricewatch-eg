# Copy to .env and edit. All optional — the app has defaults.
# Use 0.0.0.0 to reach the dashboard from your phone on the same Wi-Fi (or run ngrok against the port)
PW_HOST=127.0.0.1
PW_PORT=8765
PW_DB_PATH=data/pricewatch.db
PW_SCAN_INTERVAL_SEC=120
PW_MARKET_INTERVAL_SEC=900
# Login for the dashboard. REQUIRED before exposing it through ngrok. Leave empty = no login (local only).
PW_AUTH_USER=admin
PW_AUTH_PASSWORD=
# ntfy: one or more topics, comma separated. Each phone subscribes to one of them in the ntfy app.
# Same topic on every phone works too. Pick long random names — anyone who knows a topic can read it.
PW_NTFY_TOPICS=
PW_NTFY_SERVER=https://ntfy.sh
# Telegram (optional): create a bot with @BotFather, get chat ids via @userinfobot
PW_TELEGRAM_BOT_TOKEN=
PW_TELEGRAM_CHAT_IDS=

# Only if `playwright install chromium` is not an option: path to a Chromium/Chrome binary
PW_CHROMIUM_PATH=
# Set to false to watch the browser work (useful when a vendor shows a captcha once)
PW_PLAYWRIGHT_HEADLESS=true
